# Writes vectors.hpp from the .txtpb cases of this folder.
#
#   cmake -DPROTOC=C:/msys64/ucrt64/bin/protoc.exe -P tests/vectors/generate.cmake
#
# For each <message>.<case>.txtpb, in sorted order, it runs
# `protoc --encode=micropb.test.<message> vectors.proto` and writes the bytes as
# `vectors::<message>_<case>`. The output has no timestamp and no absolute path.

cmake_minimum_required(VERSION 3.25)

if(NOT PROTOC)
    message(FATAL_ERROR "Set PROTOC to the protoc executable: -DPROTOC=<path>")
endif()

set(dir ${CMAKE_CURRENT_LIST_DIR})
set(tmp ${dir}/../../.build/vectors)
file(MAKE_DIRECTORY ${tmp})

file(GLOB cases RELATIVE ${dir} ${dir}/*.txtpb)
list(SORT cases)

set(out "// Generated by tests/vectors/generate.cmake from the .txtpb files. Do not edit.\n")
string(APPEND out "#pragma once\n\n#include <array>\n#include <cstdint>\n\nnamespace vectors {\n")

foreach(case_file ${cases})
    if(NOT case_file MATCHES "^([^.]+)\.([^.]+)\.txtpb$")
        message(FATAL_ERROR "Bad file name: ${case_file}. Use <message>.<case>.txtpb")
    endif()
    set(message_name ${CMAKE_MATCH_1})
    set(case_name ${CMAKE_MATCH_2})
    set(bin ${tmp}/${message_name}.${case_name}.bin)

    execute_process(
        COMMAND ${PROTOC} --encode=micropb.test.${message_name} vectors.proto
        INPUT_FILE ${dir}/${case_file}
        OUTPUT_FILE ${bin}
        WORKING_DIRECTORY ${dir}
        RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "protoc failed for ${case_file}")
    endif()

    file(READ ${bin} hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")

    set(body "")
    set(index 0)
    while(index LESS hex_length)
        string(SUBSTRING "${hex}" ${index} 2 byte)
        math(EXPR position "${index} / 2")
        if(position GREATER 0)
            math(EXPR column "${position} % 16")
            if(column EQUAL 0)
                string(APPEND body ",\n    ")
            else()
                string(APPEND body ", ")
            endif()
        endif()
        string(APPEND body "0x${byte}")
        math(EXPR index "${index} + 2")
    endwhile()

    if(size EQUAL 0)
        string(APPEND out "\ninline constexpr std::array<std::uint8_t, 0> ${message_name}_${case_name}{};\n")
    else()
        string(APPEND out "\ninline constexpr std::array<std::uint8_t, ${size}> ${message_name}_${case_name}{\n    ${body}};\n")
    endif()
endforeach()

string(APPEND out "\n} // namespace vectors\n")
file(WRITE ${dir}/vectors.hpp "${out}")
